  "varietyFramework": {
    "note": "Keep the movement pattern; rotate the variation. This prevents boredom while preserving measurable progression.",
    "patterns": [
      {
        "pattern": "Horizontal press",
        "rotation": "barbell bench → dumbbell bench → weighted dips or machine press"
      },
      {
        "pattern": "Vertical pull",
        "rotation": "weighted pull-up → chin-up → neutral-grip pulldown"
      },
      {
        "pattern": "Squat pattern",
        "rotation": "front squat → safety-bar squat → hack squat"
      },
      {
        "pattern": "Hip hinge",
        "rotation": "trap-bar deadlift → Romanian deadlift → block pull"
      },
      {
        "pattern": "Shoulder press",
        "rotation": "landmine press → dumbbell press → machine press"
      },
      {
        "pattern": "Conditioning",
        "rotation": "sled push circuit → battle-rope circuit → rowing or kettlebell circuit"
      }
    ]
  },
  "progressionRules": [
    "Main lifts: when all sets reach the top of the rep range with good form, add 2.5–5 kg next week.",
    "Accessories: add repetitions first, then add the smallest available load.",
    "Conditioning: increase only one variable at a time — rounds, distance, pace or reduced rest.",
    "Sprints: begin with 4–6 × 20 m and add distance or repetitions only when speed and deceleration remain crisp.",
    "Every fourth or fifth week, reduce lifting sets by roughly 30–40% and keep conditioning easy.",
    "Stop or regress jumping, sprinting or hinge work if lower-back pain returns."
  ],
  "extraSections": [],
  "intent": "build strength, muscle, aerobic capacity, agility and resilient full-body conditioning without making every session maximal."
